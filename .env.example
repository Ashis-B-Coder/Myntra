# Application
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Public Myntra source
MYNTRA_BASE_URL=https://www.myntra.com

# Database
# Local/Docker default:
DATABASE_URL=sqlite:////app/data/myntra.db
# For managed production PostgreSQL, replace with your provider's DATABASE_URL.

# Responsible request controls
REQUEST_DELAY=1.2
REQUEST_TIMEOUT=20
MAX_RETRIES=2
MAX_CONCURRENCY=2
USER_AGENT=Mozilla/5.0 (compatible; MyntraDataCollector/1.0; +responsible-public-data-collector)

# Comma-separated browser origins. Keep * only when you intentionally need public CORS.
CORS_ORIGINS=*
